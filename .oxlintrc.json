{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "bench-data/**",
    "extra-bench-data/**"
  ],
  "rules": {
    "typescript/no-non-null-assertion": "error",
    "typescript/no-namespace": "error",
    "no-unused-vars": "error",
    "unicorn/no-useless-undefined": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "import/no-cycle": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": true,
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": [
              "test",
              "describe",
              "it",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ],
            "package": "node:test"
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-misused-spread": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/consistent-return": "off",
    "eqeqeq": "error",
    "no-param-reassign": "error",
    "no-unused-expressions": "error",
    "promise/always-return": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "Library code must run on Workers/Deno/browsers. Node-only global."
          },
          {
            "name": "Buffer",
            "message": "Library code must run on Workers/Deno/browsers. Use Uint8Array."
          },
          {
            "name": "require",
            "message": "ESM only — no CJS in library code."
          },
          {
            "name": "__dirname",
            "message": "Node-only global; library code must not touch the filesystem."
          },
          {
            "name": "__filename",
            "message": "Node-only global; library code must not touch the filesystem."
          },
          {
            "name": "document",
            "message": "Browser-only global; library code must be host-neutral."
          },
          {
            "name": "window",
            "message": "Browser-only global; library code must be host-neutral."
          },
          {
            "name": "navigator",
            "message": "Browser-only global; library code must be host-neutral."
          },
          {
            "name": "localStorage",
            "message": "Browser-only global; library code must be host-neutral."
          },
          {
            "name": "fetch",
            "message": "Library code must not perform I/O."
          },
          {
            "name": "XMLHttpRequest",
            "message": "Library code must not perform I/O."
          }
        ]
      }
    },
    {
      "files": ["src/decompress.ts", "src/compress/**/*.ts", "src/xxh64.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "eqeqeq": "off",
        "no-param-reassign": "off",
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/no-namespace": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "import/no-cycle": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off"
      }
    }
  ]
}
